{
  "name": "linkedin-engage",
  "version": "0.1.0",
  "private": true,
  "description": "LinkedIn comment auto-drafter with manual approval via your Obsidian vault. Uses Claude Code CLI for drafting.",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "scan": "tsx src/scan.ts",
    "publish": "tsx src/publish.ts",
    "status": "tsx src/status.ts",
    "setup": "tsx src/setup.ts",
    "review": "tsx src/review.ts",
    "approve": "tsx src/approve.ts",
    "redraft": "tsx src/redraft.ts",
    "kill": "tsx src/kill.ts",
    "remove": "tsx src/kill.ts",
    "good": "tsx src/good.ts",
    "sync:vault": "tsx src/vault/sync.ts",
    "pull:vault": "tsx src/vault/pull.ts",
    "draft:test": "tsx src/draft-test.ts",
    "voice:init": "tsx src/voice-init.ts",
    "voice": "${EDITOR:-open} src/ai/voice-profile.md",
    "voice:diff": "diff -u src/ai/voice-profile.md $HOME/.claude/skills/linkedin-engage/voice-profile.md || true",
    "voice:sync": "cp src/ai/voice-profile.md $HOME/.claude/skills/linkedin-engage/voice-profile.md && echo synced",
    "typecheck": "tsc --noEmit",
    "clear": "tsx src/tools/clear-all.ts",
    "queue:drafts": "tsx src/tools/queue-drafts.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
